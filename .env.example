# Database (leave blank to use local SQLite at ./hehecx.db)
DATABASE_URL=

# Supabase Storage (leave blank to store uploads locally in ./uploads)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Email (SMTP over TLS). Leave EMAIL_PASS blank to disable email verification.
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=
EMAIL_PORT=465

# Session cookie signing secret. Required when NODE_ENV=production.
# Generate with: openssl rand -hex 64
SESSION_SECRET=

# Environment
NODE_ENV=development
PORT=3000
